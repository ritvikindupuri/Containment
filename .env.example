# Supabase Configuration
# Get these values from your Supabase project settings
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_URL="https://your-project-id.supabase.co"

# Vite-prefixed variables for client-side access
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Optional: Allowed origins for CORS (comma-separated)
# Leave empty in development to allow all origins
# In production, unset ALLOWED_ORIGINS fails closed (denies all origins)
# Example: ALLOWED_ORIGINS="https://app.example.com,https://staging.example.com"
ALLOWED_ORIGINS=""

# Anthropic Claude (repo planning, risk analysis, and action reviews)
ANTHROPIC_API_KEY="your-anthropic-api-key"
# Optional: specify model override (defaults to claude-opus-5)
# ANTHROPIC_MODEL="claude-opus-5"
